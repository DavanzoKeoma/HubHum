---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/url';
import { CATEGORY_I18N_KEY } from '../../i18n/translations';
import appClusterMapRaw from '../../data/app_cluster_map.json';

interface ClusterRef {
  macro_slug: string;
  macro_title: string;
  macro_category: string;
  sub_slug: string;
  sub_title: string;
  comparison_slug: string;
  foundations_slug: string;
}

const appClusterMap = appClusterMapRaw as Record<string, ClusterRef>;

export async function getStaticPaths() {
  const apps = await getCollection('apps');
  return apps.map((app) => ({
    params: { slug: app.data.slug },
    props: { app },
  }));
}

const { app } = Astro.props;
const { Content } = await render(app);
const {
  title,
  slug,
  tags,
  is_webapp,
  app_type,
  category,
  summary,
  stars,
  icon,
  source_url,
  download_url,
  downloadUrl,
  download_label,
  license,
  operatingSystem,
  applicationCategory,
  fileSize,
  priceCurrency = 'USD',
  price = '0',
  affiliate_name,
  affiliate_url,
  affiliate_pitch,
  i18n = {},
} = app.data;

type AppType = 'desktop' | 'webapp' | 'selfhosted' | 'cli' | 'resource';

const DETAIL_TYPE_META: Record<
  AppType,
  {
    badgeClass: string;
    badgeI18n: string;
    badgeText: string;
    detailModeI18n: string;
    detailModeText: string;
    ctaI18n: string;
    ctaText: string;
  }
> = {
  webapp: {
    badgeClass: 'cloud',
    badgeI18n: 'badgeCloud',
    badgeText: 'Cloud Web App',
    detailModeI18n: 'detailModeCloud',
    detailModeText: 'Runs in your browser / cloud',
    ctaI18n: 'ctaCloud',
    ctaText: 'Open in Cloud →',
  },
  selfhosted: {
    badgeClass: 'selfhosted',
    badgeI18n: 'badgeSelfHosted',
    badgeText: 'Self-Hosted App',
    detailModeI18n: 'detailModeSelfHosted',
    detailModeText: 'Self-hosted web server (Docker / Node / Python)',
    ctaI18n: 'ctaSelfHosted',
    ctaText: 'Setup & Docs →',
  },
  cli: {
    badgeClass: 'cli',
    badgeI18n: 'badgeCli',
    badgeText: 'CLI Tool',
    detailModeI18n: 'detailModeCli',
    detailModeText: 'Command-line / terminal tool',
    ctaI18n: 'ctaCli',
    ctaText: 'Get CLI Tool →',
  },
  resource: {
    badgeClass: 'resource',
    badgeI18n: 'badgeResource',
    badgeText: 'Open Reference',
    detailModeI18n: 'detailModeResource',
    detailModeText: 'Curated open-source guide / reference',
    ctaI18n: 'ctaResource',
    ctaText: 'Browse Guide →',
  },
  desktop: {
    badgeClass: '',
    badgeI18n: 'badgeDesktop',
    badgeText: 'Desktop App',
    detailModeI18n: 'detailModeDesktop',
    detailModeText: 'Desktop GUI installer',
    ctaI18n: 'ctaDesktop',
    ctaText: 'Explore & Download →',
  },
};

const resolvedType: AppType =
  app_type || (is_webapp ? 'webapp' : 'desktop');
const {
  badgeClass,
  badgeI18n,
  badgeText,
  detailModeI18n,
  detailModeText,
  ctaI18n,
  ctaText,
} = DETAIL_TYPE_META[resolvedType];

const isHostedCloud = resolvedType === 'webapp';
const primaryHref = isHostedCloud ? (affiliate_url || download_url || source_url || '#') : (download_url || source_url || '#');
const repoSlugMatch = String(source_url || '').match(/^https?:\/\/github\.com\/([^/]+\/[^/#?]+)/i);
const repoSlug = repoSlugMatch ? repoSlugMatch[1].replace(/\.git$/, '') : null;
const catI18nKey = CATEGORY_I18N_KEY[category] || 'catProductivity';
const clusterInfo = appClusterMap[slug] || null;

const schemaCategoryMap: Record<string, string> = {
  'Security & Privacy': 'SecurityApplication',
  'Video & Audio': 'MultimediaApplication',
  'Graphics & Design': 'DesignApplication',
  'Web Apps & Cloud': 'BusinessApplication',
  'Utilities & Power Tools': 'UtilitiesApplication',
  'Websites & SEO': 'DeveloperApplication',
  Productivity: 'UtilitiesApplication',
};

const siteOrigin = (Astro.site?.toString() || 'https://davanzokeoma.github.io').replace(/\/$/, '');
const canonicalUrl = `${siteOrigin}${withBase(`/apps/${slug}/`)}`;
const resolvedDownloadUrl = downloadUrl || download_url || source_url || canonicalUrl;
const resolvedCategory = applicationCategory || schemaCategoryMap[category] || 'UtilitiesApplication';
const resolvedOs = operatingSystem || (is_webapp ? 'All / Browser' : 'Windows, macOS, Linux');
const ownerMatch = String(source_url || '').match(/^https?:\/\/github\.com\/([^/]+)/i);
const schemaOwner = ownerMatch ? ownerMatch[1] : 'Open-Source Contributors';

const appJsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': is_webapp ? 'WebApplication' : 'SoftwareApplication',
  name: title,
  description: summary || `${title} explained simply on HubHum`,
  applicationCategory: resolvedCategory,
  operatingSystem: resolvedOs,
  offers: {
    '@type': 'Offer',
    price,
    priceCurrency,
  },
  url: canonicalUrl,
  downloadUrl: resolvedDownloadUrl,
  ...(fileSize ? { fileSize } : {}),
  author: {
    '@type': 'Person',
    name: schemaOwner,
  },
  ...(stars > 0
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: '4.8',
          ratingCount: stars,
        },
      }
    : {}),
};

const breadcrumbItems: Array<Record<string, unknown>> = [
  { '@type': 'ListItem', position: 1, name: 'HubHum', item: `${siteOrigin}${withBase('/')}` },
  { '@type': 'ListItem', position: 2, name: 'Topic Guides', item: `${siteOrigin}${withBase('/guides/')}` },
];
if (clusterInfo) {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 3,
    name: clusterInfo.macro_category,
    item: `${siteOrigin}${withBase(`/guides/${clusterInfo.macro_slug}/`)}`,
  });
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 4,
    name: clusterInfo.sub_title,
    item: `${siteOrigin}${withBase(`/guides/${clusterInfo.sub_slug}/`)}`,
  });
  breadcrumbItems.push({ '@type': 'ListItem', position: 5, name: title, item: canonicalUrl });
} else {
  breadcrumbItems.push({ '@type': 'ListItem', position: 3, name: title, item: canonicalUrl });
}

const combinedJsonLd = [
  appJsonLd,
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems,
  },
];
---

<BaseLayout
  title={`${title} — HubHum`}
  description={summary || `${title} explained simply on HubHum`}
  jsonLd={combinedJsonLd}
>
  <div class="container detail-wrap">
    <nav class="cluster-breadcrumbs" aria-label="Breadcrumb">
      <a href={withBase('/')} data-i18n="catAll">All</a>
      <span aria-hidden="true">/</span>
      <a href={withBase('/guides/')} data-i18n="navGuides">Topic Guides</a>
      {clusterInfo && (
        <>
          <span aria-hidden="true">/</span>
          <a href={withBase(`/guides/${clusterInfo.macro_slug}/`)} data-i18n={catI18nKey}>
            {clusterInfo.macro_category}
          </a>
          <span aria-hidden="true">/</span>
          <a href={withBase(`/guides/${clusterInfo.sub_slug}/`)}>
            {clusterInfo.sub_title}
          </a>
        </>
      )}
      <span aria-hidden="true">/</span>
      <span aria-current="page" style="font-weight:700;color:var(--text);">{title}</span>
    </nav>

    <section class="detail-hero">
      <div style="display:flex; align-items:center; gap:1rem; max-width:680px;">
        <img
          src={withBase(icon)}
          alt=""
          width="56"
          height="56"
          decoding="async"
          class="app-logo"
          style="width:56px;height:56px;"
          aria-hidden="true"
        />
        <div>
          <div style="display:flex; flex-wrap:wrap; gap:0.45rem; align-items:center; margin-bottom:0.35rem;">
            <span class:list={['mode-badge', badgeClass]}>
              <span data-i18n={badgeI18n}>{badgeText}</span>
            </span>
            <span class="tag-chip" data-i18n={catI18nKey}>{category}</span>
            {stars > 0 ? (
              <span class="tag-chip" data-detail-stars={stars}>
                ★ {stars.toLocaleString('en')} stars on GitHub
              </span>
            ) : (
              <span class="new-badge" data-i18n="badgeNew">New</span>
            )}
          </div>
          <h1 style="margin:0; font-size:clamp(1.55rem, 3vw, 2.1rem); line-height:1.15;">{title}</h1>
          {summary && (
            <p
              id="detail-hero-summary"
              style="margin:0.4rem 0 0; color:var(--text-muted);"
              data-summary-en={summary}
              data-summary-it={i18n.it?.summary || summary}
              data-summary-es={i18n.es?.summary || summary}
              data-summary-fr={i18n.fr?.summary || summary}
              data-summary-de={i18n.de?.summary || summary}
            >
              {summary}
            </p>
          )}
        </div>
      </div>

      <div class="detail-actions">
        <a
          href={primaryHref}
          target="_blank"
          rel={isHostedCloud ? 'sponsored noopener noreferrer' : 'noopener noreferrer'}
          class:list={['btn', resolvedType === 'webapp' ? 'btn-cloud' : 'btn-primary']}
        >
          {resolvedType === 'webapp' ? (
            <span data-i18n="ctaCloud">Open in Cloud →</span>
          ) : download_label ? (
            <span>{download_label}</span>
          ) : (
            <span data-i18n={ctaI18n}>{ctaText}</span>
          )}
        </a>
        <button type="button" class="btn btn-outline" id="favorite-btn" data-slug={slug}>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
          <span id="favorite-label" data-i18n="saveFavorite">Save to Favorites</span>
        </button>
      </div>
    </section>

    <div class="detail-grid">
      <article class="article-card">
        <div
          id="localized-summary-callout"
          class="localized-callout"
          style="display:none;"
        >
          <strong data-i18n="detailSummaryNotice">Plain-language summary in your language:</strong>{' '}
          <span id="localized-summary-text"></span>
        </div>

        {resolvedType === 'cli' && (
          <div class="app-format-callout cli" role="note" data-cli-warning>
            <strong data-i18n="cliWarningTitle">Command-Line Utility (No Graphical Interface):</strong>{' '}
            <span data-i18n="cliWarningBody">
              This program runs inside your system terminal or command prompt rather than opening a desktop window. Follow the official installation instructions below.
            </span>
          </div>
        )}

        {resolvedType === 'selfhosted' && (
          <div class="app-format-callout selfhosted" role="note" data-selfhosted-warning>
            <strong data-i18n="selfHostedWarningTitle">Self-Hosted Web Application:</strong>{' '}
            <span data-i18n="selfHostedWarningBody">
              Unlike cloud SaaS apps, you run this software on your own server, NAS, or Docker container so you stay in full control of your data.
            </span>
          </div>
        )}

        <h2 style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;">
          Guide and Overview
        </h2>

        <Content />

        <div class="disclosure-note">
          <strong data-i18n="disclosureTitle">Affiliate transparency (#ad):</strong>{' '}
          <span data-i18n="disclosureBody">
            Some links on this page are affiliate links. If you choose to activate a service through them, we may earn a commission at no extra cost to you.
          </span>
        </div>
      </article>

      <aside>
        {clusterInfo && (
          <div class="side-card">
            <h2 style="margin-top:0; font-size:1.05rem;" data-i18n="clusterSidebarHeading">Topic Cluster Guides</h2>
            <ul style="padding-left:1.1rem; margin:0 0 0.85rem; color:var(--text-muted); font-size:0.9rem; display:grid; gap:0.4rem;">
              <li>
                <strong data-i18n="clusterPillarLabel">Main Category Guide:</strong>{' '}
                <a
                  href={withBase(`/guides/${clusterInfo.macro_slug}/`)}
                  style="color:var(--accent-fg-text); text-decoration:underline; font-weight:600;"
                >
                  {clusterInfo.macro_category}
                </a>
              </li>
              <li>
                <strong data-i18n="clusterSubpillarLabel">Focus Topic Hub:</strong>{' '}
                <a
                  href={withBase(`/guides/${clusterInfo.sub_slug}/`)}
                  style="color:var(--accent-fg-text); text-decoration:underline; font-weight:600;"
                >
                  {clusterInfo.sub_title}
                </a>
              </li>
            </ul>
            <a
              href={withBase(`/guides/${clusterInfo.comparison_slug}/`)}
              class="btn btn-outline"
              style="width:100%;"
              data-i18n="clusterComparisonLabel"
            >
              Compare Top Alternatives →
            </a>
          </div>
        )}

        {affiliate_url && (
          <div class="side-card affiliate-card">
            <span class="mode-badge cloud" style="margin-bottom:0.55rem; display:inline-flex;" data-i18n="partnerTipBadge">
              Sponsored Partner (#ad)
            </span>
            <h2 style="margin:0.25rem 0 0.45rem; font-size:1.05rem;">
              {affiliate_name ? (
                <span><span data-i18n="partnerHeadingPrefix">Recommended:</span> {affiliate_name}</span>
              ) : (
                <span data-i18n="partnerFallbackHeading">Enhance your setup</span>
              )}
            </h2>
            <p style="margin:0 0 0.9rem; font-size:0.9rem; color:var(--text-muted);">
              {affiliate_pitch || 'Curated partner solution suited for this software category.'}
            </p>
            <a
              href={affiliate_url}
              target="_blank"
              rel="sponsored noopener noreferrer"
              class="btn btn-cloud"
              style="width:100%;"
            >
              {isHostedCloud ? (
                <span data-i18n="partnerCloudBtn">Open in Cloud (1-Click)</span>
              ) : (
                <span>
                  <span data-i18n="partnerDiscoverPrefix">Explore</span> {affiliate_name || 'partner'} →
                </span>
              )}
            </a>
          </div>
        )}

        <div class="side-card">
          <h2 style="margin-top:0; font-size:1.05rem;" data-i18n="detailsHeading">Quick Specs</h2>
          <ul style="padding-left:1.1rem; margin:0; color:var(--text-muted); font-size:0.9rem;">
            <li>
              <strong data-i18n="detailCategory">Category:</strong>{' '}
              <span data-i18n={catI18nKey}>{category}</span>
            </li>
            <li>
              <strong data-i18n="detailMode">Format:</strong>{' '}
              <span data-i18n={detailModeI18n}>{detailModeText}</span>
            </li>
            {license && (
              <li>
                <strong data-i18n="detailLicense">License:</strong> {license}
              </li>
            )}
            {source_url && (
              <li>
                <strong data-i18n="detailOfficialPage">Official Page:</strong>{' '}
                <a
                  href={source_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  style="color:var(--accent-fg-text); text-decoration:underline; word-break:break-word;"
                >
                  {repoSlug ? (
                    <>GitHub ({repoSlug})</>
                  ) : (
                    <span data-i18n="detailOpenSource">Visit source</span>
                  )}
                </a>
              </li>
            )}
          </ul>
          <div class="tag-row" style="margin-top:0.85rem; margin-bottom:0;">
            {tags.map((t) => (
              <span class="tag-chip">#{t}</span>
            ))}
          </div>
        </div>

        <div class="side-card">
          <h2 style="margin-top:0; font-size:1.05rem;">
            <span data-i18n="reviewTitlePrefix">Have you tried</span> {title}?
          </h2>
          <p style="margin:0 0 0.8rem; font-size:0.89rem; color:var(--text-muted);" data-i18n="reviewDesc">
            Help everyday users decide by sharing a quick review.
          </p>
          <a
            href={`https://github.com/DavanzoKeoma/HubHum/issues/new?title=${encodeURIComponent(`Review: ${title}`)}&labels=review`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Write a review for ${title}`}
            class="btn btn-outline"
            style="width:100%;"
            data-i18n="reviewBtn"
          >
            Write a review
          </a>
        </div>
      </aside>
    </div>
  </div>

  <script>
    import { getFavorites, toggleFavorite } from '../../lib/github-oauth';
    import { TRANSLATIONS, type SupportedLang } from '../../i18n/translations';

    const favBtn = document.getElementById('favorite-btn') as HTMLButtonElement | null;
    const favLabel = document.getElementById('favorite-label');
    const heroSummary = document.getElementById('detail-hero-summary');
    const callout = document.getElementById('localized-summary-callout');
    const calloutText = document.getElementById('localized-summary-text');
    const detailStars = document.querySelector<HTMLElement>('[data-detail-stars]');

    function syncDetailLanguage() {
      const lang = (document.documentElement.lang || 'en') as SupportedLang;
      const dict = TRANSLATIONS[lang] || TRANSLATIONS.en;

      if (favBtn && favLabel) {
        const slug = favBtn.dataset.slug || '';
        const isSaved = getFavorites().includes(slug);
        favLabel.textContent = isSaved ? dict.savedFavorite : dict.saveFavorite;
      }

      if (heroSummary) {
        const localized = heroSummary.dataset[`summary${lang.charAt(0).toUpperCase()}${lang.slice(1)}`];
        if (localized) heroSummary.textContent = localized;
        if (callout && calloutText) {
          if (lang !== 'en' && localized) {
            calloutText.textContent = localized;
            callout.style.display = 'block';
          } else {
            callout.style.display = 'none';
          }
        }
      }

      if (detailStars) {
        const count = Number(detailStars.dataset.detailStars || '0');
        if (count > 0) {
          detailStars.textContent = `★ ${count.toLocaleString(lang)} ${dict.starsSuffix}`;
        }
      }

      const articleEl = document.querySelector('article.article-card');
      if (articleEl) {
        const headingMap: Record<string, keyof typeof dict> = {
          'what it does in plain english': 'secWhatItDoes',
          "who it's for": 'secWhoItsFor',
          'key features': 'secKeyFeatures',
          'how to install (download)': 'secHowToInstall',
          'pros and cons': 'secProsAndCons',
          'sponsored partner tools (#ad)': 'secSponsoredTools',
        };
        articleEl.querySelectorAll<HTMLElement>('h2, h3').forEach((h) => {
          if (!h.dataset.origHeading) {
            h.dataset.origHeading = (h.textContent || '').trim().toLowerCase();
          }
          const dictKey = headingMap[h.dataset.origHeading];
          if (dictKey && dict[dictKey]) {
            h.textContent = dict[dictKey];
          }
        });

        articleEl.querySelectorAll<HTMLElement>('p > em, p > strong, li > strong').forEach((el) => {
          if (!el.dataset.origText) {
            el.dataset.origText = (el.textContent || '').trim();
          }
          const origLow = el.dataset.origText.toLowerCase();
          if (origLow.startsWith('optional commercial services unrelated')) {
            el.textContent = dict.secSponsoredNote;
          } else if (origLow.startsWith('official source')) {
            el.textContent = dict.secOfficialSource;
          } else if (origLow === 'pros:' || origLow === 'pros') {
            el.textContent = el.dataset.origText.endsWith(':') ? `${dict.labelPros}:` : dict.labelPros;
          } else if (origLow === 'cons:' || origLow === 'cons') {
            el.textContent = el.dataset.origText.endsWith(':') ? `${dict.labelCons}:` : dict.labelCons;
          }
        });
      }
    }

    syncDetailLanguage();
    window.addEventListener('hubhum:langchange', syncDetailLanguage);

    if (favBtn && favLabel) {
      const slug = favBtn.dataset.slug || '';
      favBtn.addEventListener('click', () => {
        const res = toggleFavorite(slug);
        const lang = (document.documentElement.lang || 'en') as SupportedLang;
        const dict = TRANSLATIONS[lang] || TRANSLATIONS.en;
        favLabel.textContent = res.saved ? dict.savedFavorite : dict.saveFavorite;
      });
    }
  </script>
</BaseLayout>
