# HubHum Environment Variables Template
# Policy Zero-Leak: su macchina locale preferisci .pcp/vault.local.jsonl.
# Questo file serve come riferimento per GitHub Actions Secrets o override locale in .env (gitignored).
GEMINI_API_KEY=
GROQ_API_KEY=
GITHUB_TOKEN=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_REPOSITORY=DavanzoKeoma/HubHum
