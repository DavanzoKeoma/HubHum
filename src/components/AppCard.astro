---
import { withBase } from '../lib/url';
import { CATEGORY_I18N_KEY, formatCompactStars } from '../i18n/translations';

interface I18nBlock {
  it?: { tagline: string; summary: string };
  es?: { tagline: string; summary: string };
  fr?: { tagline: string; summary: string };
  de?: { tagline: string; summary: string };
}

type AppType = 'desktop' | 'webapp' | 'selfhosted' | 'cli' | 'resource';

interface Props {
  slug: string;
  title: string;
  summary: string;
  category: string;
  tags: string[];
  isWebapp: boolean;
  appType?: AppType;
  operatingSystem?: string;
  stars: number;
  icon: string;
  i18n?: I18nBlock;
  isTopPick?: boolean;
}

const {
  slug,
  title,
  summary,
  category,
  tags,
  isWebapp,
  appType,
  operatingSystem = 'Windows, macOS, Linux',
  stars,
  icon,
  i18n = {},
  isTopPick = false,
} = Astro.props;

const TYPE_META: Record<
  AppType,
  { badgeClass: string; badgeI18n: string; badgeText: string; ctaI18n: string; ctaText: string }
> = {
  webapp: {
    badgeClass: 'cloud',
    badgeI18n: 'badgeCloud',
    badgeText: 'Cloud Web App',
    ctaI18n: 'ctaCloud',
    ctaText: 'Open in Cloud →',
  },
  selfhosted: {
    badgeClass: 'selfhosted',
    badgeI18n: 'badgeSelfHosted',
    badgeText: 'Self-Hosted App',
    ctaI18n: 'ctaSelfHosted',
    ctaText: 'Setup & Docs →',
  },
  cli: {
    badgeClass: 'cli',
    badgeI18n: 'badgeCli',
    badgeText: 'CLI Tool',
    ctaI18n: 'ctaCli',
    ctaText: 'Get CLI Tool →',
  },
  resource: {
    badgeClass: 'resource',
    badgeI18n: 'badgeResource',
    badgeText: 'Open Reference',
    ctaI18n: 'ctaResource',
    ctaText: 'Browse Guide →',
  },
  desktop: {
    badgeClass: '',
    badgeI18n: 'badgeDesktop',
    badgeText: 'Desktop App',
    ctaI18n: 'ctaDesktop',
    ctaText: 'Explore & Download →',
  },
};

const resolvedType: AppType =
  appType || (isWebapp ? 'webapp' : 'desktop');
const { badgeClass, badgeI18n, badgeText, ctaI18n, ctaText } = TYPE_META[resolvedType];

const catI18nKey = CATEGORY_I18N_KEY[category] || 'catProductivity';
const searchText = `${title} ${summary} ${i18n.it?.summary || ''} ${category} ${tags.join(' ')}`.toLowerCase();
const cardAriaLabel =
  resolvedType === 'webapp'
    ? `Open ${title} in the cloud`
    : resolvedType === 'selfhosted'
    ? `Explore ${title} self-hosted setup guide`
    : resolvedType === 'cli'
    ? `Explore ${title} command-line tool`
    : resolvedType === 'resource'
    ? `Browse ${title} open reference`
    : `Explore and download ${title}`;
---

<a
  href={withBase(`/apps/${slug}`)}
  class="app-card"
  aria-label={cardAriaLabel}
  data-app-card
  data-category={category}
  data-app-type={resolvedType}
  data-os={operatingSystem}
  data-search={searchText}
  data-top-pick={isTopPick ? 'true' : 'false'}
  data-summary-en={summary}
  data-summary-it={i18n.it?.summary || summary}
  data-summary-es={i18n.es?.summary || summary}
  data-summary-fr={i18n.fr?.summary || summary}
  data-summary-de={i18n.de?.summary || summary}
>
  <div>
    <div class="app-card-top">
      <img
        src={withBase(icon)}
        alt=""
        width="44"
        height="44"
        loading="lazy"
        decoding="async"
        class="app-logo"
        aria-hidden="true"
      />
      <span class:list={['mode-badge', badgeClass]}>
        {resolvedType === 'webapp' ? (
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path>
          </svg>
        ) : resolvedType === 'selfhosted' ? (
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
            <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
            <line x1="6" y1="6" x2="6.01" y2="6"></line>
            <line x1="6" y1="18" x2="6.01" y2="18"></line>
          </svg>
        ) : resolvedType === 'cli' ? (
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="4 17 10 11 4 5"></polyline>
            <line x1="12" y1="19" x2="20" y2="19"></line>
          </svg>
        ) : resolvedType === 'resource' ? (
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
          </svg>
        ) : (
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
        )}
        <span data-i18n={badgeI18n}>{badgeText}</span>
      </span>
    </div>

    <h3 class="app-title">{title}</h3>
    <p class="app-summary" data-card-summary>{summary}</p>

    <div class="tag-row">
      <span class="tag-chip" data-i18n={catI18nKey}>{category}</span>
      {tags.slice(0, 2).map((tag) => (
        <span class="tag-chip">#{tag}</span>
      ))}
    </div>
  </div>

  <div class="app-card-foot">
    {stars > 0 ? (
      <span class="popularity-stat" title={`${stars.toLocaleString('en')} stars on GitHub`}>
        <span data-star-count={stars}>{formatCompactStars(stars)}</span>
      </span>
    ) : (
      <span class="new-badge">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3l1.9 5.8L20 10.7l-5.8 1.9L12 19l-1.9-5.8L4 11.3l5.8-1.9L12 3z"></path>
        </svg>
        <span data-i18n="badgeNew">New</span>
      </span>
    )}

    <span
      class:list={['card-cta', badgeClass]}
      data-i18n={ctaI18n}
    >
      {ctaText}
    </span>
  </div>
</a>
