---
---

<section id="live-search" class="container live-search-section" aria-labelledby="live-search-title">
  <div class="live-search-card">
    <div class="live-search-head">
      <h2 id="live-search-title" class="live-search-title" data-i18n="liveSearchEyebrow">
        Can't find your favorite open-source app?
      </h2>
    </div>

    <div class="live-search-input-wrap">
      <span class="search-icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </span>
      <input
        id="gh-live-search-input"
        class="live-search-input"
        type="search"
        role="combobox"
        aria-expanded="false"
        aria-controls="gh-search-results-grid"
        aria-autocomplete="list"
        aria-label="Search open-source projects live on GitHub"
        placeholder="Search 800M+ open-source projects on GitHub..."
        data-i18n-placeholder="liveSearchPlaceholder"
        data-i18n-aria="liveSearchAria"
      />
    </div>

    <div id="gh-search-status" class="live-search-status" aria-live="polite"></div>

    <div
      id="gh-search-results-grid"
      class="live-results-grid"
      role="grid"
      aria-label="Live GitHub Search Results"
      style="display:none;"
    ></div>
  </div>
</section>

<dialog id="conversion-dialog" class="hubhum-dialog" aria-labelledby="conv-dialog-title">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:0.75rem;margin-bottom:0.65rem;">
    <h2 id="conv-dialog-title" style="margin:0;font-size:1.12rem;" data-i18n="convTitle">Translating App Guide</h2>
    <button type="button" id="conv-close-top" class="btn btn-outline" style="padding:0.25rem 0.65rem;" aria-label="Close">✕</button>
  </div>

  <div style="display:flex;align-items:center;gap:0.6rem;margin-bottom:0.85rem;">
    <svg id="conv-spinner-icon" class="conv-spinner" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
      <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
    </svg>
    <p id="conv-target-name" style="margin:0;font-weight:700;color:var(--text);"></p>
  </div>

  <div class="progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="conv-progressbar">
    <div id="conv-progress-fill" class="progress-fill" style="width:0%;"></div>
  </div>

  <div style="display:flex;justify-content:space-between;align-items:center;gap:0.5rem;margin-top:0.6rem;">
    <p id="conv-step-text" style="margin:0;font-size:0.9rem;color:var(--text-muted);font-weight:600;"></p>
    <span id="conv-pct-label" style="font-size:0.82rem;font-weight:700;color:var(--accent);">0%</span>
  </div>
  <p id="conv-polling-note" style="margin:0.4rem 0 0;font-size:0.82rem;color:var(--text-muted);"></p>

  <div style="display:flex;justify-content:flex-end;gap:0.5rem;margin-top:1rem;">
    <button type="button" id="conv-retry-btn" class="btn btn-primary" style="display:none;" data-i18n="convRetryBtn">Try Again</button>
    <button type="button" id="conv-close-btn" class="btn btn-outline" data-i18n="dialogClose">Close</button>
  </div>
</dialog>

<script>
  import { searchGitHubProjects, slugifyRepoName, type LiveGitHubAppResult } from '../lib/github-search';
  import { triggerAppConversion } from '../lib/github-oauth';
  import { TRANSLATIONS, type SupportedLang } from '../i18n/translations';
  import { withBase } from '../lib/url';

  const searchInput = document.getElementById('gh-live-search-input') as HTMLInputElement | null;
  const statusEl = document.getElementById('gh-search-status');
  const resultsGrid = document.getElementById('gh-search-results-grid');

  const convDialog = document.getElementById('conversion-dialog') as HTMLDialogElement | null;
  const convSpinner = document.getElementById('conv-spinner-icon');
  const convTargetName = document.getElementById('conv-target-name');
  const convProgressBar = document.getElementById('conv-progressbar');
  const convProgressFill = document.getElementById('conv-progress-fill');
  const convStepText = document.getElementById('conv-step-text');
  const convPctLabel = document.getElementById('conv-pct-label');
  const convPollingNote = document.getElementById('conv-polling-note');
  const convRetryBtn = document.getElementById('conv-retry-btn');
  const convCloseBtns = [document.getElementById('conv-close-btn'), document.getElementById('conv-close-top')];

  let debounceTimer: number | null = null;
  let searchAbort: AbortController | null = null;
  let pollTimer: number | null = null;
  let stepTimer: number | null = null;
  let lastConversionRequest: { repoUrl: string; displayName: string; slugHint: string } | null = null;

  function getDict() {
    const lang = (document.documentElement.lang || 'en') as SupportedLang;
    return TRANSLATIONS[lang] || TRANSLATIONS.en;
  }

  function renderSkeletons() {
    if (!resultsGrid || !searchInput) return;
    resultsGrid.style.display = 'grid';
    searchInput.setAttribute('aria-expanded', 'true');
    resultsGrid.innerHTML = Array.from({ length: 4 })
      .map(
        () => `
      <div class="live-card live-skeleton" role="row">
        <div role="gridcell" class="skeleton-line" style="width:65%;height:16px;"></div>
        <div role="gridcell" class="skeleton-line" style="width:92%;height:12px;margin-top:8px;"></div>
        <div role="gridcell" class="skeleton-line" style="width:45%;height:28px;margin-top:12px;"></div>
      </div>`
      )
      .join('');
  }

  function clearPollingTimers() {
    if (pollTimer !== null) {
      window.clearInterval(pollTimer);
      pollTimer = null;
    }
    if (stepTimer !== null) {
      window.clearInterval(stepTimer);
      stepTimer = null;
    }
  }

  function setProgress(pct: number, stepLabel: string) {
    if (convProgressFill) convProgressFill.style.width = `${pct}%`;
    if (convProgressBar) convProgressBar.setAttribute('aria-valuenow', String(pct));
    if (convStepText) convStepText.textContent = stepLabel;
    if (convPctLabel) convPctLabel.textContent = `${pct}%`;
  }

  async function runConversionFlow(repoUrl: string, displayName: string, slugHint: string) {
    if (!convDialog || !convTargetName) return;
    const dict = getDict();
    clearPollingTimers();
    lastConversionRequest = { repoUrl, displayName, slugHint };

    convTargetName.textContent = displayName;
    if (convSpinner) convSpinner.style.display = 'inline-block';
    if (convRetryBtn) convRetryBtn.style.display = 'none';
    if (convPollingNote) convPollingNote.textContent = dict.convPollingHint;
    setProgress(15, dict.convStep1);
    if (!convDialog.open) convDialog.showModal();

    let resolvedSlug = slugHint;
    try {
      const apiRes = await triggerAppConversion(repoUrl);
      if (apiRes.slug) resolvedSlug = apiRes.slug;
    } catch {
      clearPollingTimers();
      if (convSpinner) convSpinner.style.display = 'none';
      if (convRetryBtn) convRetryBtn.style.display = 'inline-flex';
      if (convPollingNote) convPollingNote.textContent = '';
      setProgress(0, dict.convErrorMsg);
      return;
    }

    const stages = [
      { pct: 25, text: dict.convStep1 },
      { pct: 55, text: dict.convStep2 },
      { pct: 80, text: dict.convStep3 },
      { pct: 95, text: dict.convStep4 },
    ];
    let stageIdx = 1;
    stepTimer = window.setInterval(() => {
      if (stageIdx < stages.length) {
        setProgress(stages[stageIdx].pct, stages[stageIdx].text);
        stageIdx += 1;
      }
    }, 8000);

    const startedAt = Date.now();
    const maxWaitMs = 95000;
    const targetPageUrl = withBase(`/apps/${resolvedSlug}/`);

    pollTimer = window.setInterval(async () => {
      if (Date.now() - startedAt > maxWaitMs) {
        clearPollingTimers();
        if (convSpinner) convSpinner.style.display = 'none';
        if (convRetryBtn) convRetryBtn.style.display = 'inline-flex';
        setProgress(95, dict.convTimeoutMsg);
        return;
      }

      try {
        const res = await fetch(targetPageUrl, { method: 'HEAD', cache: 'no-store' });
        if (res.ok) {
          clearPollingTimers();
          if (convSpinner) convSpinner.style.display = 'none';
          setProgress(100, dict.convDone);
          window.setTimeout(() => {
            window.location.href = targetPageUrl;
          }, 600);
        }
      } catch {
        // Keep polling every 4 seconds
      }
    }, 4000);
  }

  window.addEventListener('hubhum:convert-url', (ev) => {
    const detail = (ev as CustomEvent<{ repoUrl: string; owner: string; repo: string }>).detail;
    if (!detail?.repoUrl) return;
    runConversionFlow(
      detail.repoUrl,
      `${detail.owner}/${detail.repo}`,
      slugifyRepoName(detail.repo)
    );
  });

  function renderResults(items: LiveGitHubAppResult[]) {
    if (!resultsGrid || !searchInput) return;
    const dict = getDict();
    resultsGrid.innerHTML = '';
    resultsGrid.style.display = 'grid';
    searchInput.setAttribute('aria-expanded', 'true');

    items.forEach((app) => {
      const card = document.createElement('div');
      card.className = 'live-card';
      card.setAttribute('role', 'row');

      const header = document.createElement('div');
      header.className = 'live-card-head';
      header.setAttribute('role', 'gridcell');

      const left = document.createElement('div');
      left.style.display = 'flex';
      left.style.alignItems = 'center';
      left.style.gap = '0.55rem';
      left.style.minWidth = '0';

      const img = document.createElement('img');
      img.src = app.avatarUrl;
      img.alt = '';
      img.width = 32;
      img.height = 32;
      img.loading = 'lazy';
      img.decoding = 'async';
      img.className = 'live-avatar';
      img.setAttribute('aria-hidden', 'true');

      const nameWrap = document.createElement('div');
      nameWrap.style.minWidth = '0';
      const titleLink = document.createElement('a');
      titleLink.href = app.htmlUrl;
      titleLink.target = '_blank';
      titleLink.rel = 'noopener noreferrer';
      titleLink.className = 'live-repo-link';
      titleLink.textContent = app.fullName;
      titleLink.setAttribute('aria-label', `Open ${app.fullName} on GitHub`);
      nameWrap.appendChild(titleLink);

      left.appendChild(img);
      left.appendChild(nameWrap);

      const starBadge = document.createElement('span');
      starBadge.className = 'tag-chip';
      starBadge.textContent = `★ ${app.starsFormatted}`;

      header.appendChild(left);
      header.appendChild(starBadge);

      const desc = document.createElement('p');
      desc.className = 'live-desc';
      desc.setAttribute('role', 'gridcell');
      desc.textContent = app.description;

      const metaRow = document.createElement('div');
      metaRow.className = 'tag-row';
      metaRow.setAttribute('role', 'gridcell');
      metaRow.style.marginBottom = '0.55rem';
      const catChip = document.createElement('span');
      catChip.className = 'tag-chip';
      catChip.textContent = app.humanCategory;
      metaRow.appendChild(catChip);
      app.humanTags.forEach((t) => {
        const tc = document.createElement('span');
        tc.className = 'tag-chip';
        tc.textContent = `#${t}`;
        metaRow.appendChild(tc);
      });

      const actionCell = document.createElement('div');
      actionCell.setAttribute('role', 'gridcell');
      actionCell.style.marginTop = 'auto';

      if (app.existingSlug) {
        const existingBtn = document.createElement('a');
        existingBtn.href = withBase(`/apps/${app.existingSlug}/`);
        existingBtn.className = 'btn btn-success';
        existingBtn.style.width = '100%';
        existingBtn.textContent = dict.btnAlreadyOnHubHum;
        existingBtn.setAttribute('aria-label', `Open existing guide for ${app.fullName}`);
        actionCell.appendChild(existingBtn);
      } else {
        const convertBtn = document.createElement('button');
        convertBtn.type = 'button';
        convertBtn.className = 'btn btn-cloud';
        convertBtn.style.width = '100%';
        convertBtn.textContent = dict.btnGoWithHubHum;
        convertBtn.setAttribute('aria-label', `Convert ${app.fullName} with HubHum`);
        convertBtn.addEventListener('click', () =>
          runConversionFlow(app.htmlUrl, `${app.fullName} (★ ${app.starsFormatted})`, app.slug)
        );
        actionCell.appendChild(convertBtn);
      }

      card.appendChild(header);
      card.appendChild(desc);
      card.appendChild(metaRow);
      card.appendChild(actionCell);
      resultsGrid.appendChild(card);
    });
  }

  async function runLiveSearch(query: string) {
    const dict = getDict();
    if (!statusEl || !resultsGrid || !searchInput) return;

    const clean = query.trim();
    if (clean.length < 2) {
      statusEl.textContent = '';
      resultsGrid.style.display = 'none';
      resultsGrid.innerHTML = '';
      searchInput.setAttribute('aria-expanded', 'false');
      return;
    }

    searchAbort?.abort();
    searchAbort = new AbortController();
    statusEl.textContent = dict.liveSearchLoading;
    renderSkeletons();

    try {
      const outcome = await searchGitHubProjects(clean, searchAbort.signal);
      if (outcome.status === 'ok') {
        statusEl.textContent = '';
        renderResults(outcome.items);
      } else if (outcome.status === 'rate_limited') {
        resultsGrid.style.display = 'none';
        searchInput.setAttribute('aria-expanded', 'false');
        statusEl.innerHTML = '';
        statusEl.textContent = `${dict.liveSearchRateLimit} `;
        const link = document.createElement('a');
        link.href = '#submit';
        link.textContent = dict.liveSearchRateHint;
        link.style.fontWeight = '700';
        link.style.textDecoration = 'underline';
        statusEl.appendChild(link);
      } else {
        resultsGrid.style.display = 'none';
        searchInput.setAttribute('aria-expanded', 'false');
        statusEl.textContent = dict.liveSearchEmpty;
      }
    } catch (err) {
      if (err instanceof DOMException && err.name === 'AbortError') return;
      resultsGrid.style.display = 'none';
      searchInput.setAttribute('aria-expanded', 'false');
      statusEl.textContent = dict.liveSearchEmpty;
    }
  }

  searchInput?.addEventListener('input', () => {
    if (debounceTimer !== null) window.clearTimeout(debounceTimer);
    debounceTimer = window.setTimeout(() => {
      runLiveSearch(searchInput.value);
    }, 400);
  });

  convRetryBtn?.addEventListener('click', () => {
    if (lastConversionRequest) {
      runConversionFlow(
        lastConversionRequest.repoUrl,
        lastConversionRequest.displayName,
        lastConversionRequest.slugHint
      );
    }
  });

  convDialog?.addEventListener('close', clearPollingTimers);
  convCloseBtns.forEach((b) => b?.addEventListener('click', () => convDialog?.close()));
</script>
