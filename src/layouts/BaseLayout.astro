---
import '../styles/global.css';
import { withBase } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'HubHum — A Git Hub for Humans',
  description = 'Discover hand-picked free and open-source software explained in plain language with verified official downloads.',
  jsonLd,
} = Astro.props;

const siteOrigin = (Astro.site?.toString() || 'https://davanzokeoma.github.io').replace(/\/$/, '');
const ogImageUrl = `${siteOrigin}${withBase('/og-image.png')}`;
const canonicalUrl = `${siteOrigin}${Astro.url.pathname}`;
const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'HubHum — A Git Hub for Humans',
  url: `${siteOrigin}${withBase('/')}`,
  description,
};
const effectiveJsonLd = jsonLd || defaultJsonLd;
const cfAnalyticsToken = String(import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN || '').trim();
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="google-site-verification" content="zhjr7xMD1JGKLOh9ag8b3Qgm2As1fN9T8TJksUHSzwE" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="alternate icon" href={withBase('/favicon.ico')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HubHum" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(effectiveJsonLd)} />
    <script is:inline>
      (function () {
        var supported = ['en', 'it', 'es', 'fr', 'de'];
        var lang = 'en';
        var theme = 'light';
        try {
          var savedLang = localStorage.getItem('hubhum_lang');
          if (savedLang && supported.indexOf(savedLang) !== -1) {
            lang = savedLang;
          } else if (navigator.languages && navigator.languages.length) {
            for (var i = 0; i < navigator.languages.length; i++) {
              var code = String(navigator.languages[i] || '').slice(0, 2).toLowerCase();
              if (supported.indexOf(code) !== -1) {
                lang = code;
                break;
              }
            }
          } else if (navigator.language) {
            var navCode = String(navigator.language).slice(0, 2).toLowerCase();
            if (supported.indexOf(navCode) !== -1) lang = navCode;
          }
          var savedTheme = localStorage.getItem('hubhum_theme');
          if (savedTheme === 'light' || savedTheme === 'dark') {
            theme = savedTheme;
          } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
            theme = 'dark';
          }
        } catch (_) {}
        window.__HUBHUM_LANG__ = lang;
        document.documentElement.lang = lang;
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href={withBase('/')} class="brand" aria-label="HubHum — A Git Hub for Humans">
          <img
            src={withBase('/logo.svg')}
            alt="HubHum — A Git Hub for Humans"
            width="176"
            height="38"
            class="brand-logo"
            decoding="async"
          />
        </a>

        <nav class="header-controls" aria-label="Main navigation">
          <a
            href={withBase('/guides/')}
            class="icon-nav-link"
            aria-label="Browse Topic Guides"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path>
            </svg>
            <span data-i18n="navGuides">Topic Guides</span>
          </a>

          <a
            href={withBase('/#top-picks')}
            class="icon-nav-link"
            aria-label="Jump to Top Picks"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            <span data-i18n="navTopPicks">Top Picks</span>
          </a>

          <a
            href={withBase('/#submit')}
            class="icon-nav-link"
            aria-label="Submit an open-source app"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="16"></line>
              <line x1="8" y1="12" x2="16" y2="12"></line>
            </svg>
            <span data-i18n="navSubmit">Submit an App</span>
          </a>

          <button
            type="button"
            id="theme-toggle-btn"
            class="theme-toggle-btn"
            aria-label="Toggle light and dark theme"
            data-i18n-aria="themeToggleAria"
            aria-pressed="false"
          >
            <svg id="theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            </svg>
            <svg id="theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none;">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2"></path>
              <path d="M12 20v2"></path>
              <path d="m4.93 4.93 1.41 1.41"></path>
              <path d="m17.66 17.66 1.41 1.41"></path>
              <path d="M2 12h2"></path>
              <path d="M20 12h2"></path>
              <path d="m6.34 17.66-1.41 1.41"></path>
              <path d="m19.07 4.93-1.41 1.41"></path>
            </svg>
          </button>

          <label for="lang-switcher" class="sr-only" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);">Language</label>
          <select id="lang-switcher" class="lang-select" aria-label="Language">
            <option value="en">EN</option>
            <option value="it">IT</option>
            <option value="es">ES</option>
            <option value="fr">FR</option>
            <option value="de">DE</option>
          </select>

          <button type="button" id="oauth-login-btn" class="btn btn-outline" aria-label="View saved favorites or optional GitHub sync">
            <img id="oauth-avatar" src="" alt="" width="20" height="20" class="oauth-avatar" style="display:none;" />
            <svg id="oauth-default-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
            <span id="oauth-login-label" data-i18n="navFavorites">Favorites</span>
          </button>

          <button
            type="button"
            id="mobile-menu-btn"
            class="mobile-menu-btn"
            aria-label="Toggle navigation menu"
            aria-expanded="false"
            aria-controls="mobile-drawer"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
        </nav>
      </div>

      <div id="mobile-drawer" class="container mobile-drawer" aria-label="Mobile navigation">
        <a href={withBase('/guides/')} class="btn btn-outline" data-i18n="navGuides">Topic Guides</a>
        <a href={withBase('/#top-picks')} class="btn btn-outline" data-i18n="navTopPicks">Top Picks</a>
        <a href={withBase('/#submit')} class="btn btn-outline" data-i18n="navSubmit">Submit an App</a>
        <a href={withBase('/about/')} class="btn btn-outline" data-i18n="aboutLink">About &amp; Transparency</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <dialog id="favorites-dialog" class="hubhum-dialog" aria-labelledby="dialog-title">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:0.75rem;margin-bottom:0.5rem;">
        <h2 id="dialog-title" style="margin:0;font-size:1.15rem;" data-i18n="dialogTitle">Your Saved Favorites</h2>
        <button type="button" id="dialog-close-top" class="btn btn-outline" style="padding:0.25rem 0.65rem;" aria-label="Close">✕</button>
      </div>

      <p id="dialog-desc" style="margin:0;color:var(--text-muted);font-size:0.9rem;" data-i18n="dialogDescLocal">
        Your favorite apps are saved right here in this browser.
      </p>
      <ul id="dialog-fav-list" class="fav-list"></ul>

      <hr class="dialog-divider" />

      <div id="oauth-signin-box">
        <p style="margin:0 0 0.65rem;font-size:0.86rem;color:var(--text-muted);" data-i18n="oauthSignInDesc">
          Sign in with one click to link your GitHub profile and sync favorites.
        </p>
        <button type="button" id="github-1click-signin" class="btn btn-github-oauth">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"></path>
          </svg>
          <span data-i18n="oauthSignInBtn">Sign in with GitHub</span>
        </button>
      </div>

      <p id="oauth-status-msg" style="margin:0.55rem 0 0;font-size:0.84rem;color:var(--text-muted);"></p>

      <div style="display:flex;justify-content:flex-end;gap:0.5rem;margin-top:1rem;">
        <button type="button" id="dialog-logout-btn" class="btn btn-outline" style="display:none;" data-i18n="dialogLogout">Sign Out</button>
        <button type="button" id="dialog-close-btn" class="btn btn-primary" data-i18n="dialogClose">Close</button>
      </div>
    </dialog>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-disclaimer" data-i18n="footerDisclaimer">
          HubHum is an independent directory and is not affiliated with GitHub, Inc.
        </div>
        <div data-i18n="footerAffiliate">
          Affiliate transparency (#ad): Some links on HubHum are affiliate links. If you purchase a service through them, we may earn a commission at no extra cost to you.
        </div>
        <div data-i18n="footerCredits">
          All listed software links strictly to official creator channels in full respect of open-source licenses.
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:1rem;margin-top:0.35rem;font-weight:600;color:var(--text);">
          <a href={withBase('/guides/')} style="text-decoration:underline;" data-i18n="navGuides">Topic Guides</a>
          <a href={withBase('/about/')} style="text-decoration:underline;" data-i18n="aboutLink">About &amp; Transparency</a>
          <a href={withBase('/privacy/')} style="text-decoration:underline;" data-i18n="privacyLink">Privacy Policy</a>
          <a href={withBase('/dashboard/')} style="text-decoration:underline;" data-i18n="dashboardLink">Dashboard</a>
          <a href={withBase('/sitemap-index.xml')} style="text-decoration:underline;" data-i18n="sitemapLink">Sitemap</a>
        </div>
      </div>
    </footer>

    <script>
      import {
        clearSavedSession,
        exchangeOAuthCode,
        getFavorites,
        getSavedSession,
        startGitHubWebOAuth,
        toggleFavorite,
      } from '../lib/github-oauth';
      import { formatCompactStars, SUPPORTED_LANGS, TRANSLATIONS, type SupportedLang } from '../i18n/translations';
      import { withBase } from '../lib/url';

      // Theme switching (Light / Dark)
      const themeToggleBtn = document.getElementById('theme-toggle-btn') as HTMLButtonElement | null;
      const moonIcon = document.getElementById('theme-icon-moon');
      const sunIcon = document.getElementById('theme-icon-sun');

      function applyTheme(nextTheme: 'light' | 'dark') {
        document.documentElement.dataset.theme = nextTheme;
        try {
          localStorage.setItem('hubhum_theme', nextTheme);
        } catch {}
        if (themeToggleBtn) {
          themeToggleBtn.setAttribute('aria-pressed', String(nextTheme === 'dark'));
        }
        if (moonIcon && sunIcon) {
          moonIcon.style.display = nextTheme === 'dark' ? 'none' : 'inline-block';
          sunIcon.style.display = nextTheme === 'dark' ? 'inline-block' : 'none';
        }
      }

      applyTheme(document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
      themeToggleBtn?.addEventListener('click', () => {
        const cur = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
        applyTheme(cur === 'dark' ? 'light' : 'dark');
      });

      const win = window as unknown as { __HUBHUM_LANG__?: string };
      let currentLang: SupportedLang = (
        SUPPORTED_LANGS.includes(win.__HUBHUM_LANG__ as SupportedLang) ? win.__HUBHUM_LANG__ : 'en'
      ) as SupportedLang;

      function applyTranslations(lang: SupportedLang) {
        currentLang = lang;
        const dict = TRANSLATIONS[lang];
        document.documentElement.lang = lang;
        try {
          localStorage.setItem('hubhum_lang', lang);
        } catch {}

        document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
          const key = el.dataset.i18n as keyof typeof dict;
          if (key && dict[key]) el.textContent = dict[key];
        });

        document.querySelectorAll<HTMLInputElement>('[data-i18n-placeholder]').forEach((el) => {
          const key = el.dataset.i18nPlaceholder as keyof typeof dict;
          if (key && dict[key]) el.placeholder = dict[key];
        });

        document.querySelectorAll<HTMLElement>('[data-i18n-aria]').forEach((el) => {
          const key = el.dataset.i18nAria as keyof typeof dict;
          if (key && dict[key]) el.setAttribute('aria-label', dict[key]);
        });

        document.querySelectorAll<HTMLElement>('[data-app-card]').forEach((card) => {
          const sumEl = card.querySelector<HTMLElement>('[data-card-summary]');
          const localizedSum = card.dataset[`summary${lang.charAt(0).toUpperCase()}${lang.slice(1)}`];
          if (sumEl && localizedSum) {
            sumEl.textContent = localizedSum;
          }
          const starEl = card.querySelector<HTMLElement>('[data-star-count]');
          if (starEl) {
            const count = Number(starEl.dataset.starCount || '0');
            if (count > 0) {
              starEl.textContent = formatCompactStars(count);
              starEl.title = `${count.toLocaleString(lang)} ${dict.starsSuffix}`;
            }
          }
        });

        window.dispatchEvent(new CustomEvent('hubhum:langchange', { detail: { lang, dict } }));
      }

      const langSwitcher = document.getElementById('lang-switcher') as HTMLSelectElement | null;
      if (langSwitcher) {
        langSwitcher.value = currentLang;
        langSwitcher.addEventListener('change', () => {
          const next = langSwitcher.value as SupportedLang;
          if (SUPPORTED_LANGS.includes(next)) {
            applyTranslations(next);
          }
        });
      }

      applyTranslations(currentLang);

      // Mobile menu toggle
      const mobileBtn = document.getElementById('mobile-menu-btn');
      const mobileDrawer = document.getElementById('mobile-drawer');
      mobileBtn?.addEventListener('click', () => {
        const isOpen = mobileDrawer?.classList.toggle('open') || false;
        mobileBtn.setAttribute('aria-expanded', String(isOpen));
      });

      // 1-Click GitHub Web OAuth + Local Favorites Dialog (#favorites-dialog)
      const loginBtn = document.getElementById('oauth-login-btn') as HTMLButtonElement | null;
      const loginLabel = document.getElementById('oauth-login-label');
      const avatarImg = document.getElementById('oauth-avatar') as HTMLImageElement | null;
      const defaultIcon = document.getElementById('oauth-default-icon');
      const dialog = document.getElementById('favorites-dialog') as HTMLDialogElement | null;
      const favList = document.getElementById('dialog-fav-list');
      const dialogDesc = document.getElementById('dialog-desc');
      const oauthSignInBox = document.getElementById('oauth-signin-box');
      const githubSignInBtn = document.getElementById('github-1click-signin');
      const oauthStatusMsg = document.getElementById('oauth-status-msg');
      const logoutBtn = document.getElementById('dialog-logout-btn');
      const closeBtns = [document.getElementById('dialog-close-btn'), document.getElementById('dialog-close-top')];

      function renderSessionUI() {
        const session = getSavedSession();
        if (loginLabel && session?.login) {
          loginLabel.textContent = `@${session.login}`;
          loginLabel.removeAttribute('data-i18n');
          if (avatarImg && session.avatarUrl) {
            avatarImg.src = session.avatarUrl;
            avatarImg.style.display = 'inline-block';
            if (defaultIcon) defaultIcon.style.display = 'none';
          }
          if (oauthSignInBox) oauthSignInBox.style.display = 'none';
        } else if (loginLabel) {
          loginLabel.setAttribute('data-i18n', 'navFavorites');
          loginLabel.textContent = TRANSLATIONS[currentLang].navFavorites;
          if (avatarImg) avatarImg.style.display = 'none';
          if (defaultIcon) defaultIcon.style.display = 'inline-block';
          if (oauthSignInBox) oauthSignInBox.style.display = 'block';
        }
      }

      function renderFavoritesList() {
        if (!favList || !dialogDesc) return;
        const dict = TRANSLATIONS[currentLang];
        const session = getSavedSession();
        const favs = getFavorites();

        dialogDesc.textContent = session?.login ? dict.dialogDescAuth : dict.dialogDescLocal;
        if (logoutBtn) logoutBtn.style.display = session?.login ? 'inline-flex' : 'none';

        favList.innerHTML = '';
        if (favs.length === 0) {
          const li = document.createElement('li');
          li.style.color = 'var(--text-muted)';
          li.style.fontSize = '0.9rem';
          li.textContent = dict.dialogNoFavs;
          favList.appendChild(li);
        } else {
          favs.forEach((slug) => {
            const li = document.createElement('li');
            li.className = 'fav-row';
            const a = document.createElement('a');
            a.href = withBase(`/apps/${slug}`);
            a.className = 'fav-link';
            a.style.flex = '1';
            a.textContent = slug;
            const arrow = document.createElement('span');
            arrow.textContent = '→';
            a.appendChild(arrow);

            const remBtn = document.createElement('button');
            remBtn.type = 'button';
            remBtn.className = 'btn btn-outline';
            remBtn.style.padding = '0.35rem 0.6rem';
            remBtn.setAttribute('aria-label', `Remove ${slug} from favorites`);
            remBtn.textContent = '✕';
            remBtn.addEventListener('click', () => {
              toggleFavorite(slug);
              renderFavoritesList();
            });

            li.appendChild(a);
            li.appendChild(remBtn);
            favList.appendChild(li);
          });
        }
      }

      renderSessionUI();

      // Intercept ?code= returned by GitHub Web OAuth callback
      const urlParams = new URLSearchParams(window.location.search);
      const oauthCode = urlParams.get('code');
      if (oauthCode) {
        window.history.replaceState({}, document.title, window.location.pathname);
        if (oauthStatusMsg) oauthStatusMsg.textContent = TRANSLATIONS[currentLang].oauthConnecting;
        exchangeOAuthCode(oauthCode)
          .then(() => {
            renderSessionUI();
            renderFavoritesList();
            if (oauthStatusMsg) oauthStatusMsg.textContent = '';
          })
          .catch(() => {
            if (oauthStatusMsg) oauthStatusMsg.textContent = '';
          });
      }

      loginBtn?.addEventListener('click', () => {
        renderSessionUI();
        renderFavoritesList();
        if (oauthStatusMsg) oauthStatusMsg.textContent = '';
        dialog?.showModal();
      });

      dialog?.addEventListener('close', () => {
        loginBtn?.focus();
      });

      githubSignInBtn?.addEventListener('click', () => {
        startGitHubWebOAuth();
      });

      logoutBtn?.addEventListener('click', () => {
        clearSavedSession();
        renderSessionUI();
        renderFavoritesList();
      });

      closeBtns.forEach((btn) => btn?.addEventListener('click', () => dialog?.close()));
    </script>
    {cfAnalyticsToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cfAnalyticsToken })}
      ></script>
    )}
  </body>
</html>
