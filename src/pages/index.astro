---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AppCard from '../components/AppCard.astro';
import GitHubSearchConvert from '../components/GitHubSearchConvert.astro';
import { withBase } from '../lib/url';
import { CATEGORY_I18N_KEY } from '../i18n/translations';

const PAGE_SIZE = 24;

const allApps = await getCollection('apps');
const sortedApps = [...allApps].sort((a, b) => (b.data.stars || 0) - (a.data.stars || 0));

const topPicks = sortedApps.filter((app) => (app.data.stars || 0) > 0).slice(0, 3);
const topPickSlugs = new Set(topPicks.map((app) => app.data.slug));
const initialPageApps = sortedApps.slice(0, PAGE_SIZE);
const totalPages = Math.max(1, Math.ceil(sortedApps.length / PAGE_SIZE));

const allGuides = await getCollection('guides');
const pillarGuides = allGuides
  .filter((g) => g.data.level === 1)
  .sort((a, b) => b.data.app_slugs.length - a.data.app_slugs.length);

const categories = [
  'All',
  'Productivity',
  'Security & Privacy',
  'Graphics & Design',
  'Video & Audio',
  'Web Apps & Cloud',
  'Utilities & Power Tools',
];

const categoryCounts: Record<string, number> = {
  All: sortedApps.length,
};
for (const cat of categories.slice(1)) {
  categoryCounts[cat] = sortedApps.filter((app) => app.data.category === cat).length;
}
---

<BaseLayout
  title="HubHum — Powerful Free Software, Zero Tech Jargon"
  description="Hand-picked selection of the best free and open-source software explained without technical jargon."
>
  <section class="hero container">
    <div class="hero-badge">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3l1.9 5.8L20 10.7l-5.8 1.9L12 19l-1.9-5.8L4 11.3l5.8-1.9L12 3z"></path>
      </svg>
      <span data-i18n="eyebrow">Hand-picked selection of the best free software</span>
    </div>

    <h1 data-i18n="heroTitle">Powerful free software, zero tech jargon</h1>
    <p data-i18n="heroSubtitle">
      No complicated terms. Find out what each program really does and download the official version right away.
    </p>

    <div class="search-box-wrap">
      <span class="search-icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </span>
      <input
        id="hubhum-search"
        class="search-input"
        type="search"
        placeholder="Search by name or task (e.g., video, passwords...)"
        aria-label="Search software catalog"
        data-i18n-placeholder="searchPlaceholder"
        data-i18n-aria="searchAriaLabel"
      />
    </div>

    <div
      class="underline-nav"
      role="group"
      aria-label="Filter by category"
      data-i18n-aria="categoriesLabel"
    >
      {categories.map((cat, idx) => (
        <button
          type="button"
          class="underline-nav-item"
          aria-pressed={idx === 0 ? 'true' : 'false'}
          data-category-btn={cat}
        >
          <span data-i18n={CATEGORY_I18N_KEY[cat]}>{cat}</span>
          <span class="underline-counter" data-cat-count={cat}>{categoryCounts[cat] ?? 0}</span>
        </button>
      ))}
    </div>
  </section>

  <GitHubSearchConvert />

  {topPicks.length > 0 && (
    <section id="top-picks" class="section-block container">
      <div class="section-head">
        <h2 data-i18n="topPicksHeading">Top Picks This Week</h2>
        <span class="section-sub" data-i18n="topPicksSub">Most starred open-source software in the catalog</span>
      </div>
      <div class="top-picks-track">
        {topPicks.map((app) => (
          <AppCard
            slug={app.data.slug}
            title={app.data.title}
            summary={app.data.summary}
            category={app.data.category}
            tags={app.data.tags}
            isWebapp={app.data.is_webapp}
            appType={app.data.app_type}
            stars={app.data.stars}
            icon={app.data.icon}
            i18n={app.data.i18n}
          />
        ))}
      </div>
    </section>
  )}

  <section id="catalog-section" class="section-block container">
    <div class="section-head">
      <h2 data-i18n="allSoftwareHeading">All Software</h2>
      <span class="section-sub" id="catalog-count" data-total-apps={sortedApps.length}>
        {sortedApps.length} apps available
      </span>
    </div>
    <div class="apps-grid" id="catalog-grid" data-page-size={PAGE_SIZE}>
      {initialPageApps.map((app) => (
        <AppCard
          slug={app.data.slug}
          title={app.data.title}
          summary={app.data.summary}
          category={app.data.category}
          tags={app.data.tags}
          isWebapp={app.data.is_webapp}
          appType={app.data.app_type}
          stars={app.data.stars}
          icon={app.data.icon}
          i18n={app.data.i18n}
          isTopPick={topPickSlugs.has(app.data.slug)}
        />
      ))}
    </div>
    <p id="empty-search-msg" style="display:none; color: var(--text-muted); margin-top: 1rem;" data-i18n="emptySearch">
      No apps match your search. Try another keyword or submit a link below.
    </p>

    <div class="pagination-bar" id="pagination-bar">
      <span class="pagination-info" id="pagination-info">
        <span data-i18n="pageLabel">Page</span> <span id="page-num">1</span> <span data-i18n="ofLabel">of</span> <span id="page-total">{totalPages}</span>
      </span>
      <div class="pagination-controls">
        <button type="button" id="page-prev-btn" class="btn btn-outline" disabled data-i18n="pagePrev">
          Previous
        </button>
        <button type="button" id="load-more-btn" class="btn btn-outline" data-i18n="loadMoreBtn">
          Load 24 more
        </button>
        <button
          type="button"
          id="page-next-btn"
          class="btn btn-primary"
          disabled={totalPages <= 1}
          data-i18n="pageNext"
        >
          Next
        </button>
      </div>
    </div>
  </section>

  {pillarGuides.length > 0 && (
    <section class="section-block container">
      <div class="section-head">
        <div>
          <h2 data-i18n="guidesHeading">Topic Guides &amp; Comparisons</h2>
          <span class="section-sub" data-i18n="guidesSub">
            Practical buyer guides, alternatives, and troubleshooting organized by topic
          </span>
        </div>
        <a href={withBase('/guides/')} class="btn btn-outline" data-i18n="guidesAllCta">
          Browse all Topic Guides →
        </a>
      </div>
      <div class="apps-grid">
        {pillarGuides.map((pillar) => (
          <a
            href={withBase(`/guides/${pillar.data.slug}/`)}
            class="app-card"
            aria-label={`Read topic guide: ${pillar.data.title}`}
          >
            <div>
              <div class="app-card-top">
                <span class="mode-badge">{pillar.data.macro_category}</span>
                <span class="tag-chip">{pillar.data.child_slugs.length} focus hubs</span>
              </div>
              <h3 class="app-title">{pillar.data.title}</h3>
              <p class="app-summary">{pillar.data.summary}</p>
            </div>
            <div class="app-card-foot">
              <span class="popularity-stat">
                {pillar.data.app_slugs.length}+ <span data-i18n="guideAppsIncluded">apps covered</span>
              </span>
              <span class="card-cta" data-i18n="guideReadMore">Explore guide →</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <section id="submit" class="container">
    <div class="translate-panel">
      <h2 style="margin-top:0; margin-bottom:0.35rem;" data-i18n="submitTitle">Submit an App</h2>
      <p style="margin:0; color:var(--text-muted);" data-i18n="submitDesc">
        Paste any GitHub URL to add a plain-English guide to HubHum
      </p>
      <form id="async-translate-form" class="translate-form">
        <input
          id="repo-url-input"
          class="translate-input"
          type="url"
          required
          placeholder="https://github.com/author/app-name"
          aria-label="Project GitHub URL"
          data-i18n-placeholder="submitPlaceholder"
        />
        <button type="submit" class="btn btn-primary" data-i18n="submitBtn">Submit App</button>
      </form>
      <div id="translate-status" class="status-banner" role="status" aria-live="polite"></div>
    </div>
  </section>

  <script>
    import { normalizeGitHubProjectUrl } from '../lib/github-oauth';
    import { CATEGORY_I18N_KEY, formatCompactStars, TRANSLATIONS, type SupportedLang } from '../i18n/translations';
    import { withBase } from '../lib/url';

    interface CatalogEntry {
      slug: string;
      name: string;
      category: string;
      tags?: string[];
      icon: string;
      is_webapp: boolean;
      app_type?: 'desktop' | 'webapp' | 'cli';
      stars: number;
      summary: string;
      i18n?: Record<string, string>;
    }

    const PAGE_SIZE = 24;
    const searchInput = document.getElementById('hubhum-search') as HTMLInputElement | null;
    const categoryButtons = document.querySelectorAll<HTMLButtonElement>('[data-category-btn]');
    const catalogGrid = document.getElementById('catalog-grid');
    const catalogSection = document.getElementById('catalog-section');
    const catalogCount = document.getElementById('catalog-count');
    const emptyMsg = document.getElementById('empty-search-msg');
    const topPicksSection = document.getElementById('top-picks');
    const pageNumEl = document.getElementById('page-num');
    const pageTotalEl = document.getElementById('page-total');
    const prevBtn = document.getElementById('page-prev-btn') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('page-next-btn') as HTMLButtonElement | null;
    const loadMoreBtn = document.getElementById('load-more-btn') as HTMLButtonElement | null;
    const paginationBar = document.getElementById('pagination-bar');

    let selectedCategory = 'All';
    let currentPage = 1;
    let visibleExtraPages = 0;
    let catalogCache: CatalogEntry[] | null = null;
    let catalogPromise: Promise<CatalogEntry[]> | null = null;
    let hasInteracted = false;

    function getActiveLang(): SupportedLang {
      return (document.documentElement.lang || 'en') as SupportedLang;
    }

    function getActiveDict() {
      const lang = getActiveLang();
      return TRANSLATIONS[lang] || TRANSLATIONS.en;
    }

    async function ensureCatalogLoaded(): Promise<CatalogEntry[]> {
      if (catalogCache) return catalogCache;
      if (!catalogPromise) {
        catalogPromise = fetch(withBase('/catalog-index.json'))
          .then((res) => (res.ok ? res.json() : []))
          .then((items) => {
            catalogCache = Array.isArray(items) ? items : [];
            return catalogCache;
          })
          .catch(() => {
            catalogCache = [];
            return [];
          });
      }
      return catalogPromise;
    }

    function createBadgeSvg(appType: 'desktop' | 'webapp' | 'cli'): SVGSVGElement {
      const ns = 'http://www.w3.org/2000/svg';
      const svg = document.createElementNS(ns, 'svg');
      svg.setAttribute('width', '14');
      svg.setAttribute('height', '14');
      svg.setAttribute('viewBox', '0 0 24 24');
      svg.setAttribute('fill', 'none');
      svg.setAttribute('stroke', 'currentColor');
      svg.setAttribute('stroke-width', '2.1');
      svg.setAttribute('stroke-linecap', 'round');
      svg.setAttribute('stroke-linejoin', 'round');
      svg.setAttribute('aria-hidden', 'true');
      if (appType === 'webapp') {
        const p = document.createElementNS(ns, 'path');
        p.setAttribute('d', 'M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z');
        svg.appendChild(p);
      } else if (appType === 'cli') {
        const poly = document.createElementNS(ns, 'polyline');
        poly.setAttribute('points', '4 17 10 11 4 5');
        const ln = document.createElementNS(ns, 'line');
        ln.setAttribute('x1', '12');
        ln.setAttribute('y1', '19');
        ln.setAttribute('x2', '20');
        ln.setAttribute('y2', '19');
        svg.appendChild(poly);
        svg.appendChild(ln);
      } else {
        const rect = document.createElementNS(ns, 'rect');
        rect.setAttribute('x', '2');
        rect.setAttribute('y', '3');
        rect.setAttribute('width', '20');
        rect.setAttribute('height', '14');
        rect.setAttribute('rx', '2');
        rect.setAttribute('ry', '2');
        const l1 = document.createElementNS(ns, 'line');
        l1.setAttribute('x1', '8');
        l1.setAttribute('y1', '21');
        l1.setAttribute('x2', '16');
        l1.setAttribute('y2', '21');
        const l2 = document.createElementNS(ns, 'line');
        l2.setAttribute('x1', '12');
        l2.setAttribute('y1', '17');
        l2.setAttribute('x2', '12');
        l2.setAttribute('y2', '21');
        svg.appendChild(rect);
        svg.appendChild(l1);
        svg.appendChild(l2);
      }
      return svg;
    }

    function createAppCardNode(item: CatalogEntry): HTMLAnchorElement {
      const lang = getActiveLang();
      const dict = getActiveDict();
      const appType: 'desktop' | 'webapp' | 'cli' =
        item.app_type || (item.is_webapp ? 'webapp' : 'desktop');
      const badgeClass = appType === 'webapp' ? 'cloud' : appType === 'cli' ? 'cli' : '';
      const badgeI18n = appType === 'webapp' ? 'badgeCloud' : appType === 'cli' ? 'badgeCli' : 'badgeDesktop';
      const ctaI18n = appType === 'webapp' ? 'ctaCloud' : appType === 'cli' ? 'ctaCli' : 'ctaDesktop';
      const catKey = CATEGORY_I18N_KEY[item.category] || 'catProductivity';

      const card = document.createElement('a');
      card.href = withBase(`/apps/${item.slug}`);
      card.className = 'app-card';
      card.setAttribute('data-app-card', '');
      card.dataset.category = item.category;
      card.dataset.appType = appType;
      card.dataset.summaryEn = item.summary;
      card.dataset.summaryIt = item.i18n?.it || item.summary;
      card.dataset.summaryEs = item.i18n?.es || item.summary;
      card.dataset.summaryFr = item.i18n?.fr || item.summary;
      card.dataset.summaryDe = item.i18n?.de || item.summary;

      const topGroup = document.createElement('div');
      const cardTop = document.createElement('div');
      cardTop.className = 'app-card-top';

      const img = document.createElement('img');
      img.src = withBase(item.icon || '/icons/hubhum.svg');
      img.alt = '';
      img.width = 44;
      img.height = 44;
      img.loading = 'lazy';
      img.decoding = 'async';
      img.className = 'app-logo';
      img.setAttribute('aria-hidden', 'true');

      const badge = document.createElement('span');
      badge.className = `mode-badge ${badgeClass}`.trim();
      badge.appendChild(createBadgeSvg(appType));
      const badgeText = document.createElement('span');
      badgeText.setAttribute('data-i18n', badgeI18n);
      badgeText.textContent = dict[badgeI18n];
      badge.appendChild(badgeText);

      cardTop.appendChild(img);
      cardTop.appendChild(badge);
      topGroup.appendChild(cardTop);

      const h3 = document.createElement('h3');
      h3.className = 'app-title';
      h3.textContent = item.name;

      const p = document.createElement('p');
      p.className = 'app-summary';
      p.setAttribute('data-card-summary', '');
      p.textContent = (lang !== 'en' && item.i18n?.[lang]) || item.summary;

      const tagRow = document.createElement('div');
      tagRow.className = 'tag-row';
      const catSpan = document.createElement('span');
      catSpan.className = 'tag-chip';
      catSpan.setAttribute('data-i18n', catKey);
      catSpan.textContent = dict[catKey] || item.category;
      tagRow.appendChild(catSpan);
      (item.tags || []).slice(0, 2).forEach((t) => {
        const tg = document.createElement('span');
        tg.className = 'tag-chip';
        tg.textContent = `#${t}`;
        tagRow.appendChild(tg);
      });

      topGroup.appendChild(h3);
      topGroup.appendChild(p);
      topGroup.appendChild(tagRow);

      const foot = document.createElement('div');
      foot.className = 'app-card-foot';

      if ((item.stars || 0) > 0) {
        const pop = document.createElement('span');
        pop.className = 'popularity-stat';
        pop.title = `${item.stars.toLocaleString(lang)} ${dict.starsSuffix}`;
        const starVal = document.createElement('span');
        starVal.setAttribute('data-star-count', String(item.stars));
        starVal.textContent = formatCompactStars(item.stars);
        pop.appendChild(starVal);
        foot.appendChild(pop);
      } else {
        const nb = document.createElement('span');
        nb.className = 'new-badge';
        const nbText = document.createElement('span');
        nbText.setAttribute('data-i18n', 'badgeNew');
        nbText.textContent = dict.badgeNew;
        nb.appendChild(nbText);
        foot.appendChild(nb);
      }

      const cta = document.createElement('span');
      cta.className = `card-cta ${badgeClass}`.trim();
      cta.setAttribute('data-i18n', ctaI18n);
      cta.textContent = dict[ctaI18n];
      foot.appendChild(cta);

      card.appendChild(topGroup);
      card.appendChild(foot);
      return card;
    }

    function updatePaginationUI(filteredCount: number, endIndex: number) {
      const dict = getActiveDict();
      const totalPages = Math.max(1, Math.ceil(filteredCount / PAGE_SIZE));
      if (catalogCount) {
        catalogCount.textContent = `${filteredCount} ${dict.appsAvailableSuffix}`;
      }
      if (emptyMsg) {
        emptyMsg.style.display = filteredCount === 0 ? 'block' : 'none';
      }
      if (paginationBar) {
        paginationBar.style.display = filteredCount > 0 ? 'flex' : 'none';
      }
      if (pageNumEl) pageNumEl.textContent = String(currentPage);
      if (pageTotalEl) pageTotalEl.textContent = String(totalPages);
      if (prevBtn) prevBtn.disabled = currentPage <= 1;
      if (nextBtn) nextBtn.disabled = endIndex >= filteredCount;
      if (loadMoreBtn) {
        loadMoreBtn.style.display = endIndex < filteredCount ? 'inline-flex' : 'none';
      }
    }

    async function renderCatalogPage() {
      const q = (searchInput?.value || '').trim().toLowerCase();
      const isDefaultView = !q && selectedCategory === 'All' && currentPage === 1 && visibleExtraPages === 0;

      if (topPicksSection) {
        topPicksSection.style.display = !q && selectedCategory === 'All' ? 'block' : 'none';
      }

      if (!hasInteracted) {
        const total = Number(catalogCount?.dataset.totalApps || '0');
        updatePaginationUI(total, Math.min(PAGE_SIZE, total));
        return;
      }

      const allItems = await ensureCatalogLoaded();
      const filtered = allItems.filter((item) => {
        const matchesCat = selectedCategory === 'All' || item.category === selectedCategory;
        if (!matchesCat) return false;
        if (!q) return true;
        const hay = `${item.name} ${item.summary} ${Object.values(item.i18n || {}).join(' ')} ${item.category} ${(item.tags || []).join(' ')}`.toLowerCase();
        return hay.includes(q);
      });

      const startIdx = (currentPage - 1) * PAGE_SIZE;
      const endIdx = Math.min(filtered.length, startIdx + PAGE_SIZE * (1 + visibleExtraPages));
      const slice = filtered.slice(startIdx, endIdx);

      if (catalogGrid) {
        const frag = document.createDocumentFragment();
        slice.forEach((item) => frag.appendChild(createAppCardNode(item)));
        catalogGrid.replaceChildren(frag);
      }
      updatePaginationUI(filtered.length, endIdx);
      if (isDefaultView) {
        window.dispatchEvent(new CustomEvent('hubhum:catalogrendered'));
      }
    }

    updatePaginationUI(
      Number(catalogCount?.dataset.totalApps || '0'),
      Math.min(PAGE_SIZE, Number(catalogCount?.dataset.totalApps || '0'))
    );

    window.addEventListener('hubhum:langchange', () => {
      const totalEl = catalogCount;
      if (!hasInteracted && totalEl) {
        const total = Number(totalEl.dataset.totalApps || '0');
        updatePaginationUI(total, Math.min(PAGE_SIZE, total));
      } else {
        renderCatalogPage();
      }
    });

    searchInput?.addEventListener('input', () => {
      hasInteracted = true;
      currentPage = 1;
      visibleExtraPages = 0;
      renderCatalogPage();
    });

    categoryButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        hasInteracted = true;
        categoryButtons.forEach((b) => b.setAttribute('aria-pressed', 'false'));
        btn.setAttribute('aria-pressed', 'true');
        selectedCategory = btn.dataset.categoryBtn || 'All';
        currentPage = 1;
        visibleExtraPages = 0;
        renderCatalogPage();
      });
    });

    prevBtn?.addEventListener('click', () => {
      if (currentPage <= 1) return;
      hasInteracted = true;
      currentPage -= 1;
      visibleExtraPages = 0;
      renderCatalogPage();
      catalogSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    nextBtn?.addEventListener('click', () => {
      hasInteracted = true;
      currentPage += 1 + visibleExtraPages;
      visibleExtraPages = 0;
      renderCatalogPage();
      catalogSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    loadMoreBtn?.addEventListener('click', () => {
      hasInteracted = true;
      visibleExtraPages += 1;
      renderCatalogPage();
    });

    const translateForm = document.getElementById('async-translate-form') as HTMLFormElement | null;
    const urlInput = document.getElementById('repo-url-input') as HTMLInputElement | null;
    const statusBox = document.getElementById('translate-status');

    translateForm?.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      if (!urlInput || !statusBox) return;
      const dict = getActiveDict();
      const parsed = normalizeGitHubProjectUrl(urlInput.value);
      if (!parsed) {
        statusBox.textContent = dict.submitInvalidUrl;
        statusBox.classList.add('visible');
        return;
      }
      statusBox.textContent = dict.submitSuccess;
      statusBox.classList.add('visible');
      window.dispatchEvent(
        new CustomEvent('hubhum:convert-url', {
          detail: { repoUrl: parsed.url, owner: parsed.owner, repo: parsed.repo },
        })
      );
    });
  </script>
</BaseLayout>
